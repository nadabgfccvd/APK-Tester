<?xml version="1.0" encoding="utf-8"?>
<!-- Regras de extracao de dados (API 31+): banco privado em cloud-backup e device-transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="."/>
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="."/>
    </device-transfer>
</data-extraction-rules>
